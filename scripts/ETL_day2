import logging
import os
from pathlib import Path
import sys
from urllib.parse import quote_plus

import pandas as pd
from dotenv import load_dotenv
from sqlalchemy import create_engine

# ---------- Config (from .env) ----------
load_dotenv()  # read .env into environment variables
BASE_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = BASE_DIR / os.getenv("DATA_DIR", "/Users/meemeemaung/Documents/GitHub/olist-de-capstone/data/raw")
ORDERS_FILE = DATA_DIR / "olist_orders_dataset.csv"
CUSTOMERS_FILE = DATA_DIR / "olist_customers_dataset.csv"

DB_USER = os.getenv("DB_USER", "postgres")
DB_PASSWORD = os.getenv("DB_PASSWORD", "")
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_PORT = os.getenv("DB_PORT", "5432")
DB_NAME = os.getenv("DB_NAME", "olist")
DB_URL = (f"postgresql+psycopg2://{DB_USER}:{quote_plus(DB_PASSWORD)}"
          f"@{DB_HOST}:{DB_PORT}/{DB_NAME}")

TARGET_SCHEMA = "staging"
TARGET_TABLE = "stg_delivered_orders"
DATE_FORMAT = "%Y-%m-%d %H:%M:%S"

# ---------- Logging ----------
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    handlers=[logging.FileHandler("etl.log"), logging.StreamHandler()],
)
log = logging.getLogger(__name__)


def extract():
    log.info("Extract: reading CSV files")
    try:
        orders = pd.read_csv(ORDERS_FILE, dtype=str)
        customers = pd.read_csv(CUSTOMERS_FILE, dtype=str)
    except FileNotFoundError as e:
        log.error(f"File not found: {e.filename}")
        raise
    log.info(f"Read {len(orders):,} orders and {len(customers):,} customers")
    return orders, customers


def transform(orders, customers):
    log.info("Transform: filtering, joining, adding columns")

    # 1. Filter: delivered orders only
    df = orders[orders["order_status"] == "delivered"].copy()

    # 2. Text to dates (explicit format)
    for col in ["order_purchase_timestamp", "order_delivered_customer_date"]:
        df[col] = pd.to_datetime(df[col], format=DATE_FORMAT, errors="coerce")

    # 3. Drop rows with no delivery date, and log it
    before = len(df)
    df = df.dropna(subset=["order_delivered_customer_date"])
    dropped = before - len(df)
    if dropped:
        log.warning(f"Dropped {dropped} delivered orders with no delivery date")

    # 4. New column: delivery days
    df["delivery_days"] = (
        df["order_delivered_customer_date"] - df["order_purchase_timestamp"]
    ).dt.days

    # 5. Join customers (SQL LEFT JOIN)
    rows_before = len(df)
    df = df.merge(
        customers[["customer_id", "customer_city", "customer_state"]],
        on="customer_id", how="left", validate="many_to_one",
    )
    assert len(df) == rows_before, "merge changed the row count"

    # 6. Keep only the columns we need
    df = df[["order_id", "customer_id", "customer_city", "customer_state",
             "order_purchase_timestamp", "order_delivered_customer_date",
             "delivery_days"]]

    log.info(f"Transform done: {len(df):,} rows")
    return df


def load(df, table):
    log.info(f"Load: writing to {TARGET_SCHEMA}.{table}")
    engine = create_engine(DB_URL)
    with engine.begin() as conn:
        df.to_sql(table, conn, schema=TARGET_SCHEMA, if_exists="replace", index=False)
    log.info(f"Loaded {len(df):,} rows")


def main():
    log.info("===== ETL started =====")
    try:
        orders, customers = extract()
        result = transform(orders, customers)
        load(result, TARGET_TABLE)
    except Exception:
        log.exception("ETL failed")
        sys.exit(1)
    log.info("===== ETL finished successfully =====")


if __name__ == "__main__":
    main()
